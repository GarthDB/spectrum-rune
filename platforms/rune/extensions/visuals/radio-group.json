{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "radio-group",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "parts": {
    "container": {
      "kind": "box",
      "children": [
        "row"
      ],
      "props": {
        "direction": {
          "value": "row"
        }
      }
    },
    "options": {
      "kind": "slot",
      "sizeMap": {
        "s": "s",
        "m": "m",
        "l": "l",
        "xl": "xl"
      },
      "props": {
        "align": {
          "value": "center"
        },
        "gap": {
          "token": {
            "property": "gap",
            "structure": "group",
            "size": "{size}"
          }
        },
        "direction": {
          "value": "row"
        }
      }
    },
    "row": {
      "kind": "box",
      "children": [
        "options"
      ],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "start"
        }
      }
    }
  }
}